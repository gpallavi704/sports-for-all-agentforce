<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" cache="false">
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content="Ask Sport Compass about fencing, parafencing and your next step. Public guidance powered by Salesforce Agentforce." />
    <link rel="icon" type="image/png" href="{!$Resource.SportCompassTeamAvatar}" />
    <title>Ask Sport Compass | Sports 4 All</title>
    <style>
        :root { color-scheme: light; --navy: #101832; --blue: #0756cf; --gold: #eebf5d; --paper: #edf4fc; --ink: #121c30; --muted: #4a596c; --line: #d1d9e4; --white: #fff; }
        * { box-sizing: border-box; }
        body { margin: 0; color: var(--ink); background: var(--paper); font: 1rem/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: var(--blue); text-underline-offset: .22em; }
        a:hover { text-decoration-thickness: 2px; }
        :focus-visible { outline: 3px solid var(--blue); outline-offset: 5px; }
        button { font: inherit; touch-action: manipulation; cursor: pointer; }
        button:disabled { cursor: wait; }
        .skip { position: absolute; top: -5rem; left: 1rem; z-index: 5; background: white; padding: .75rem 1rem; }
        .skip:focus { top: .75rem; }
        .site-header { background: var(--white); border-bottom: 1px solid var(--line); }
        .header-inner { max-width: 80rem; margin: auto; padding: .65rem clamp(1rem, 4vw, 3rem); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
        .site-logo { display: block; width: 156px; height: 78px; object-fit: contain; }
        nav { display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }
        nav a { color: var(--ink); font-weight: 600; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
        nav a:hover { color: var(--blue); text-decoration: underline; }
        nav .current { background: var(--blue); color: white; border-radius: 2rem; padding: .6rem 1.2rem; }
        nav .current:hover { color: white; }
        main { width: min(100%, 60rem); margin: auto; padding: 2.25rem 2rem 5.5rem; }
        h1, h2, h3 { letter-spacing: -.035em; }
        h1 { font-size: clamp(1.9rem, 4vw, 2.35rem); line-height: 1.2; margin: 0 0 .55rem; font-weight: 800; }
        .subtitle { margin: 0 0 1.5rem; color: var(--muted); }
        .chat-card { border-radius: 1.75rem; overflow: hidden; background: white; border: 1px solid var(--line); box-shadow: 0 14px 44px rgba(16,24,50,.07); }
        .card-header { background: var(--navy); color: white; display: flex; align-items: start; justify-content: space-between; gap: 1.5rem; padding: 1.5rem 1.75rem; }
        .agent-id { display: flex; align-items: start; gap: .9rem; min-width: 0; }
        .avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
        .card-header h2 { font-size: 1.3rem; line-height: 1.25; margin: .05rem 0 .4rem; letter-spacing: -.02em; }
        .card-header p { max-width: 29rem; margin: 0; color: #ced7e9; font-size: .94rem; }
        .platform { display: flex; gap: .4rem; align-items: center; margin-top: .7rem; color: var(--gold); font-size: .72rem; font-weight: 650; letter-spacing: .035em; text-transform: uppercase; }
        .status-pill { display: inline-flex; align-items: center; gap: .5rem; white-space: nowrap; border: 1px solid #52617d; border-radius: 2rem; padding: .4rem .85rem; font-size: .82rem; color: #e4ebf7; background: #222d48; }
        .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); }
        .status-pill.ready .status-dot { background: #8ce6bc; }
        .welcome { padding: 2.1rem 2rem 1.3rem; text-align: center; }
        .welcome h3 { font-size: clamp(1.4rem, 3vw, 1.85rem); line-height: 1.25; margin: 0 0 .7rem; }
        .welcome p { max-width: 35rem; margin: 0 auto 1.25rem; color: var(--muted); }
        .primary { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: .65rem; padding: .75rem 1.6rem; border-radius: 2rem; border: 2px solid var(--blue); background: var(--blue); color: white; font-weight: 700; }
        .primary:hover { background: #0648ad; border-color: #0648ad; }
        .primary:disabled { background: #dce5f0; color: #43536b; border-color: #dce5f0; }
        .chat-actions { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; justify-content: center; }
        .secondary { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: .6rem; border: 2px solid var(--blue); border-radius: 2rem; padding: .75rem 1.3rem; font-weight: 700; text-decoration: none; background: white; }
        .secondary:hover { background: var(--paper); }
        [hidden] { display: none !important; }
        .start-note { margin: .7rem 0 0 !important; font-size: .8rem; }
        .questions { padding: .5rem 2rem 1.6rem; }
        .section-label { margin: 0 0 .8rem; font-size: .78rem; color: var(--muted); font-weight: 750; letter-spacing: .04em; text-transform: uppercase; }
        .question-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; }
        .question { border: 1px solid var(--line); border-radius: 1.1rem; min-height: 72px; padding: .9rem 1rem; background: white; color: var(--ink); display: flex; align-items: center; justify-content: space-between; gap: .75rem; text-align: left; line-height: 1.5; box-shadow: 0 2px 3px rgba(16,24,50,.035); }
        .question:hover { background: #f3f7ff; border-color: var(--blue); }
        .question svg { flex-shrink: 0; color: #566781; }
        svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
        .feedback { min-height: 1.6em; margin: .9rem 0 0; color: var(--muted); font-size: .85rem; }
        .card-foot { padding: 1rem 1.75rem; background: #f7f9fc; border-top: 1px solid #e0e6ef; display: flex; gap: .7rem; align-items: start; }
        .card-foot svg { flex-shrink: 0; color: var(--blue); margin-top: 3px; }
        .card-foot p { margin: 0; font-size: .87rem; color: var(--muted); }
        .card-foot strong { color: var(--ink); }
        .support-note { display: flex; align-items: center; gap: .6rem; padding: 1.2rem .2rem .8rem; color: var(--muted); font-size: .9rem; }
        .support-note svg { color: var(--blue); flex-shrink: 0; }
        details { margin: .5rem 0 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: .55rem .2rem; color: var(--muted); font-size: .9rem; }
        summary { cursor: pointer; color: var(--ink); font-weight: 650; min-height: 44px; align-content: center; }
        details p { max-width: 48rem; margin: .7rem 0; }
        footer { padding: 1.15rem .2rem 0; display: flex; gap: .75rem 1.5rem; justify-content: space-between; flex-wrap: wrap; color: var(--muted); font-size: .85rem; }
        .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
        @media (max-width: 700px) { .header-inner { padding: .45rem 1.2rem; } .site-logo { width: 128px; height: 64px; } nav { gap: .75rem; } nav .desktop-link { display: none; } nav .current { font-size: .85rem; padding: .55rem .85rem; } main { padding: 1.6rem 1rem 6rem; } .card-header { padding: 1.25rem; gap: .7rem; flex-wrap: wrap; } .card-header .status-pill { margin-left: 3.9rem; } .welcome { padding: 1.75rem 1.25rem 1rem; } .questions { padding: .5rem 1.25rem 1.25rem; } .card-foot { padding: 1rem 1.25rem; } .question-grid { grid-template-columns: 1fr; } .question { min-height: 64px; } }
        @media (max-width: 360px) { nav .current { padding: .55rem .65rem; } .site-logo { width: 112px; height: 56px; } }
        @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation: none !important; transition: none !important; } }
    </style>
</head>
<body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site-header"><div class="header-inner">
        <a href="https://sports-4-all.org/"><img class="site-logo" src="{!$Resource.Sports4AllLogo}" alt="Sports 4 All home" width="156" height="78" /></a>
        <nav aria-label="Main navigation"><a class="desktop-link" href="https://sports-4-all.org/">Fencing for All</a><a class="desktop-link" href="https://sports-4-all.org/accessibility">Accessibility</a><a class="desktop-link" href="https://sports-4-all.org/impact">Impact</a><a class="current" href="#main" aria-current="page">Ask Sport Compass</a></nav>
    </div></header>
    <main id="main">
        <h1 id="page-heading">Ask Sport Compass</h1><p id="page-subtitle" class="subtitle">Fencing for every starting point. Let's find yours.</p>
        <section class="chat-card" aria-labelledby="agent-name">
            <div class="card-header">
                <div class="agent-id"><img class="avatar" src="{!$Resource.SportCompassTeamAvatar}" alt="" width="48" height="48" /><div><h2 id="agent-name">Sport Compass</h2><p id="agent-description">Your AI guide to fencing, parafencing and taking that first step.</p><span class="platform"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6z" /><path d="m8 12 3 3 5-6" /></svg><span id="platform-label">Powered by Salesforce Agentforce + Data Cloud</span></span></div></div>
                <span id="connection-state" class="status-pill"><span class="status-dot" aria-hidden="true"></span><span id="connection-label">Loading chat</span></span>
            </div>
            <div class="welcome">
                <h3 id="welcome-heading">A new sport. A little guidance.</h3>
                <p id="welcome-description">Explore wheelchair fencing, find club information or plan your first visit. Start with a question, big or small.</p>
                <div class="chat-actions"><button id="start-chat" class="primary" type="button" onclick="openSportCompass()" disabled="disabled"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 11a8 8 0 0 1-8 8H7l-5 3 2-6a8 8 0 1 1 17-5z" /><path d="M8 11h.01M12 11h.01M16 11h.01" /></svg><span id="start-label">Loading chat</span></button><a id="switch-chat" class="secondary" href="?support=human#main" aria-describedby="switch-note"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 12H2v6h4v-6zM20 12h2v6h-4v-6zM20 18v3h-7" /></svg><span id="switch-label">Chat with a person</span></a></div>
                <p id="start-note" class="start-note">Opens Salesforce chat on this page. No sign-in needed.</p>
                <p id="switch-note" class="start-note">Human support goes to our project team when available. Switching views resets the chat window; earlier messages are not transferred.</p>
                <noscript><p>Chat needs JavaScript. You can still use the <a href="https://member.usafencing.org/clubs">USA Fencing club finder</a>.</p></noscript>
            </div>
            <div class="questions"><div id="suggested-questions"><p class="section-label">Need an idea? Copy a question into chat.</p><div class="question-grid">
                <button class="question" type="button" onclick="copyQuestion(this)"><span class="question-text">Can my daughter try fencing from a wheelchair?</span><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V4H4v12h4" /></svg><span class="sr-only">Copy question</span></button>
                <button class="question" type="button" onclick="copyQuestion(this)"><span class="question-text">What equipment should a beginner ask about?</span><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V4H4v12h4" /></svg><span class="sr-only">Copy question</span></button>
                <button class="question" type="button" onclick="copyQuestion(this)"><span class="question-text">Find a real fencing club in Salt Lake City, Utah.</span><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V4H4v12h4" /></svg><span class="sr-only">Copy question</span></button>
                <button class="question" type="button" onclick="copyQuestion(this)"><span class="question-text">What should I ask a coach before my first visit?</span><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V4H4v12h4" /></svg><span class="sr-only">Copy question</span></button>
            </div></div><p id="chat-status" class="feedback" role="status" aria-live="polite" aria-atomic="true">Getting your chat ready...</p></div>
            <div class="card-foot"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" /></svg><p><strong>A little care goes a long way.</strong> Please leave out names, contact details and medical or account information. Chat messages are processed and retained in Salesforce.</p></div>
        </section>
        <p class="support-note"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 12H2v6h4v-6zM20 12h2v6h-4v-6zM20 18v3h-7" /></svg><span id="support-description">Choose Chat with a person to reach the project team directly, or ask the AI guide about a transfer. Availability varies.</span></p>
        <details><summary>About this experience and your privacy</summary>
            <p>This is a team-built Agentforce for Good prototype, not an official USA Fencing service. Guidance comes from project-prepared public-source summaries and a small reviewed club directory. Confirm club accessibility, equipment and availability directly.</p>
            <p>Only official classifiers and event staff decide classification and competition eligibility. Sport Compass cannot access private member records, create support Cases, send emails or make bookings in this public chat.</p>
            <p>If you agree to a human transfer, a Sport Compass project operator can read this conversation. It is not a transfer to USA Fencing staff, and no callback or immediate response is promised. Your conversation on the separate Sports 4 All website is not automatically copied here.</p>
            <p>The direct human option opens a separate project-team chat. The team can read what you send in that chat; AI messages are not automatically shared. Switching between AI and human views resets the active chat window and limits displayed history to the selected channel. Please finish your current chat before switching.</p>
            <p>Messages may remain in the hackathon Salesforce org after you end the chat. Do not enter sensitive information. For official resources, use the <a href="https://member.usafencing.org/clubs">USA Fencing club finder</a>.</p>
        </details>
        <footer><span>Sports 4 All. A place to begin.</span><a href="https://sports-4-all.org/ask">Visit the Sports 4 All website</a></footer>
    </main>
    <script>
        var humanSupport = new URLSearchParams(window.location.search).get('support') === 'human';
        var deployment = humanSupport ? {
            name: 'SportCompass_HumanSupport',
            site: 'https://orgfarm-4d89d5ac56.my.site.com/ESWSportCompassHumanSupp1788815170553'
        } : {
            name: 'SportCompass_PublicChat',
            site: 'https://orgfarm-4d89d5ac56.my.site.com/ESWSportCompassPublicCha1788806382470'
        };
        var chatReady = false;
        var chatStatus = document.getElementById('chat-status');
        var chatButton = document.getElementById('start-chat');
        var startLabel = document.getElementById('start-label');
        if (humanSupport) {
            document.title = 'Chat with the team | Sports 4 All';
            document.getElementById('page-heading').textContent = 'Chat with the team';
            document.getElementById('page-subtitle').textContent = 'A real conversation. A helpful next step.';
            document.getElementById('agent-name').textContent = 'Sports for All team';
            document.getElementById('agent-description').textContent = 'Speak directly with a person from the Sport Compass project team.';
            document.getElementById('platform-label').textContent = 'Human support through Salesforce Omni-Channel';
            document.getElementById('welcome-heading').textContent = 'A person to help you get started.';
            document.getElementById('welcome-description').textContent = 'Ask about taking your first step in fencing. This chat goes straight to our project team, without an AI agent.';
            document.getElementById('switch-chat').href = window.location.pathname + '#main';
            document.getElementById('switch-label').textContent = 'Ask the AI guide';
            document.getElementById('start-note').textContent = 'No sign-in needed. You are connected only after a team member accepts your chat.';
            document.getElementById('switch-note').textContent = 'Availability varies. Switching to the AI guide resets this chat window; messages are not transferred.';
            document.getElementById('suggested-questions').hidden = true;
            document.getElementById('support-description').textContent = 'Our project team is not USA Fencing staff. If nobody is available, the AI guide can still help with public fencing information.';
        }
        function chatUnavailable() {
            chatStatus.textContent = humanSupport ? 'Support chat is unavailable right now. The team may be offline, the queue may be full, or chat could not load. Try again later or choose Ask the AI guide.' : 'Chat could not load. Reload this page or use the official club finder in the details below.';
            startLabel.textContent = 'Chat unavailable';
            document.getElementById('connection-label').textContent = 'Unavailable';
            chatButton.disabled = true;
        }
        window.addEventListener('onEmbeddedMessagingButtonCreated', function () {
            chatReady = true;
            chatButton.disabled = false;
            startLabel.textContent = humanSupport ? 'Start human chat' : 'Start a conversation';
            document.getElementById('connection-label').textContent = humanSupport ? 'Support chat ready' : 'Chat ready';
            document.getElementById('connection-state').classList.add('ready');
            chatStatus.textContent = humanSupport ? 'Open the chat and send your question. You will see when a team member joins.' : 'Ready when you are. Start a conversation to ask the AI guide.';
        });
        window.setTimeout(function () { if (!chatReady) chatUnavailable(); }, 30000);
        function initEmbeddedMessaging() {
            try {
                embeddedservice_bootstrap.settings.language = 'en_US';
                embeddedservice_bootstrap.settings.restrictSessionOnMessagingChannel = true;
                embeddedservice_bootstrap.init('00DgL00000c7pj3', deployment.name, deployment.site, {scrt2URL: 'https://orgfarm-4d89d5ac56.my.salesforce-scrt.com'});
            } catch (error) { chatUnavailable(); }
        }
        function openSportCompass() {
            if (!chatReady) return;
            chatButton.disabled = true;
            chatStatus.textContent = 'Opening Salesforce chat...';
            embeddedservice_bootstrap.utilAPI.launchChat()
                .then(function () { chatStatus.textContent = humanSupport ? 'Chat is open. Send your question and wait for a team member to accept. Opening the window does not mean you are connected.' : 'Chat is open. Type your question in the chat window.'; })
                .catch(function () { chatStatus.textContent = 'Chat could not open. Please try again.'; })
                .finally(function () { chatButton.disabled = false; });
        }
        function copyQuestion(button) {
            var question = button.querySelector('.question-text').textContent;
            if (!navigator.clipboard) { chatStatus.textContent = 'Select and copy the question text, then paste it into chat.'; return; }
            navigator.clipboard.writeText(question).then(function () {
                chatStatus.textContent = 'Question copied. Open the chat and paste it when you are ready. Nothing has been sent.';
            }).catch(function () { chatStatus.textContent = 'Copy was blocked by your browser. Select the question text to copy it yourself.'; });
        }
        var bootstrapScript = document.createElement('script');
        bootstrapScript.src = deployment.site + '/assets/js/bootstrap.min.js';
        bootstrapScript.async = true;
        bootstrapScript.onload = initEmbeddedMessaging;
        bootstrapScript.onerror = chatUnavailable;
        document.body.appendChild(bootstrapScript);
    </script>
</body>
</html>
</apex:page>
